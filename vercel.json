{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30,
      "includeFiles": "backend/public/**"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index?momoPath=/" },
    { "source": "/:path*", "destination": "/api/index?momoPath=/:path*" }
  ]
}
