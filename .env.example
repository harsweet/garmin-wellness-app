# Copy to .env and add an xAI API key. This file contains no real credentials.
XAI_API_KEY=
XAI_MODEL=grok-4.7
# Optional: initial profile time zone. You can change it in Momo's setup page.
MOMO_TIME_ZONE=America/Edmonton

# Vercel deployment only: connect Upstash in Vercel Marketplace to populate these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use the token generated in .local/demo-device-token for the matching watch build.
MOMO_DEVICE_TOKEN=
# Optional stable production URL, e.g. https://your-project.vercel.app
MOMO_PUBLIC_URL=
